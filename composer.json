{
    "name": "glofora/gsend-transport",
    "description": "gSend mail transport driver and client for Laravel and PHP",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Glofora Solutions",
            "email": "info@glofora.com",
            "homepage": "https://glofora.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "symfony/mailer": "^6.0 || ^7.0 || ^8.0",
        "symfony/mime": "^6.0 || ^7.0 || ^8.0",
        "guzzlehttp/guzzle": "^7.5",
        "psr/log": "^1.0 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0",
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0",
        "mockery/mockery": "^1.6"
    },
    "suggest": {
        "illuminate/mail": "Required to use the gSend transport driver inside Laravel (^9.0|^10.0|^11.0|^12.0)",
        "illuminate/support": "Required for Laravel service provider integration (^9.0|^10.0|^11.0|^12.0)"
    },
    "autoload": {
        "psr-4": {
            "Glofora\\GSend\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Glofora\\GSend\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Glofora\\GSend\\GSendServiceProvider"
            ],
            "aliases": {
                "GSend": "Glofora\\GSend\\Facades\\GSend"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}